{
  "manifest_version": 3,
  "name": "New Tab Dashboard",
  "version": "1.0.8",
  "description": "Personal new-tab page: markets, local weather, today's calendar and Notion to-dos.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab-dashboard@xrdashboard",
      "update_url": "https://raw.githubusercontent.com/chiaxr/XrDashboard/main/updates.json",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms",
    "topSites",
    "geolocation"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://seasonal-api.open-meteo.com/*",
    "https://archive-api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://calendar.google.com/*",
    "https://api.notion.com/*",
    "https://www.alphavantage.co/*"
  ]
}
